# Django Settings
SECRET_KEY=your_production_secret_key_here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Razorpay API Keys (Replace with production keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
